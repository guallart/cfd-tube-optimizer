FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [velocity];
internalField   uniform (0 0 0);

boundaryField
{
    // Types of the constraint patches, needed for the processor boundaries
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            surfaceNormalFixedValue;
        refValue        uniform -{{velocity}};
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            noSlip;
    }
}
