FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}

vertices
(
    ({{xmin}} {{ymin}} {{zmin}})
    ({{xmax}} {{ymin}} {{zmin}})
    ({{xmax}} {{ymax}} {{zmin}})
    ({{xmin}} {{ymax}} {{zmin}})
    ({{xmin}} {{ymin}} {{zmax}})
    ({{xmax}} {{ymin}} {{zmax}})
    ({{xmax}} {{ymax}} {{zmax}})
    ({{xmin}} {{ymax}} {{zmax}})
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{nx}} {{ny}} {{nz}}) simpleGrading (1 1 1)
);

// Background box only. All its cells outside the tube are removed by
// snappyHexMesh, so these patches disappear from the final mesh.
boundary
(
    background
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (2 6 5 1)
            (3 7 6 2)
            (1 5 4 0)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);
